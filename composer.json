{
    "name": "jambtc/yii2-toastr-widget",
    "description": "Un widget Yii2 per flash messages usando Toastr",
    "type": "yii2-extension",
    "keywords": ["yii2", "widget", "toastr", "notifications"],
    "license": "MIT",
    "authors": [
        {
            "name": "jambtc",
            "email": "jambtc@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "yiisoft/yii2": "~2.0.0",
        "npm-asset/toastr": "^2.1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "jambtc\\ToastrWidget\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "jambtc\\ToastrWidget\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
